# Variable-name reference only. Hardhat does not automatically load this file.
# Prefer the encrypted keystore commands documented in README.md.
# Base Sepolia only. Never commit a funded private key.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Optional. When omitted, the deployer receives the test supply.
INITIAL_HOLDER=0xYOUR_TESTNET_INITIAL_HOLDER

# CoinMarketCap API. Keep the real key local and never commit it.
CMC_API_KEY=YOUR_CMC_API_KEY

# Add the numeric CoinMarketCap ID assigned to DATCORE after its listing.
# Until then, the market-context command returns BTC, ETH, and USDC context.
CMC_DATCORE_ID=
